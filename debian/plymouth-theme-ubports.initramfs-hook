#!/bin/sh

set -e

PREREQ=""

prereqs()
{
	echo "${PREREQ}"
}

case "${1}" in
	prereqs)
		prereqs
		exit 0
		;;
esac

. /usr/share/initramfs-tools/hook-functions

mkdir -p "${DESTDIR}/usr/share/plymouth/themes/ubports"
cp /usr/share/plymouth/themes/ubports/* "${DESTDIR}/usr/share/plymouth/themes/ubports"
